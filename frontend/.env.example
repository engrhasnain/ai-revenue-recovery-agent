# Backend origin (protocol + host + port only, no path). Used by
# next.config.ts to proxy "/api/v1/*" requests to the backend — this is the
# single source of truth for the backend location; do not hardcode the port
# anywhere else.
#
# Local dev (matches `uv run uvicorn app.main:app --port 8000`):
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public demo deployment example:
# NEXT_PUBLIC_API_URL=https://api-demo-revenuerecovery.example.com
