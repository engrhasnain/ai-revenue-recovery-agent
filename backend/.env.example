# App
APP_NAME="AI Revenue Recovery Agent"
APP_ENV=production
DEBUG=false

# SECRET_KEY is required — the app will refuse to start without a real value.
# It must NOT be left blank and must NOT be any of the old placeholder strings
# ("change-me-in-production", "dev-secret-key-change-in-production", etc).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./revenue_recovery.db

# Anthropic Claude — leave blank to run in demo mode (pre-written responses,
# no live API calls, no cost/risk from anonymous public traffic)
ANTHROPIC_API_KEY=

# Notifications — SIMULATED ONLY in this deployment. send_email/send_sms/
# send_whatsapp only log and return True; nothing is actually sent, and
# these SMTP/Twilio values are not read for public-demo sending. Leave blank.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# CORS — the single origin allowed to call this API (e.g. the public demo
# frontend URL linked from the marketing site). No wildcard.
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGIN=https://demo-revenuerecovery.example.com

# ─── Public demo deployment ─────────────────────────────────
# When true: destructive endpoints (deletes, irreversible bulk actions)
# return 403, and interactive API docs (/docs, /redoc) are disabled.
PUBLIC_DEMO_MODE=true

# How often (minutes) the demo database is restored to its seeded state.
DEMO_RESET_INTERVAL_MINUTES=60
